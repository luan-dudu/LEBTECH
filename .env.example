# ─── Banco de Dados (Neon) ────────────────────────────────────────────────────
# Cole aqui a connection string do seu projeto no neon.tech
DATABASE_URL=postgresql://usuario:senha@ep-xxxxx.us-east-2.aws.neon.tech/leb_tech?sslmode=require

# ─── Autenticação ─────────────────────────────────────────────────────────────
JWT_SECRET=mude-esta-chave-para-algo-longo-e-aleatorio-em-producao

# Credenciais do admin principal (não cadastrado no banco, acesso direto)
ADMIN_EMAIL=admin@lebtech.com.br
ADMIN_PASSWORD=troque-esta-senha-em-producao

# ─── LEB IA (Assistente virtual) ──────────────────────────────────────────────
# Gere sua chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=cole-sua-chave-aqui
GEMINI_MODEL=gemini-3.8-flash
# WhatsApp do técnico que recebe os atendimentos (somente números, com DDI)
TECH_WHATSAPP=5512988176687

# ─── Ambiente ─────────────────────────────────────────────────────────────────
NODE_ENV=development
